{
  "name": "@lobbyd/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript types generated from the API's OpenAPI document. Do not edit src/schema.d.ts by hand.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5"
  }
}