{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/uv.lock",
      "{workspaceRoot}/package-lock.json",
      "{workspaceRoot}/.python-version",
      "{workspaceRoot}/.github/workflows/ci.yml"
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"]
  },
  "targetDefaults": {
    "lint": { "cache": true, "inputs": ["default"] },
    "typecheck": { "cache": true, "inputs": ["default"] },
    "boundaries": { "cache": true, "inputs": ["default"] },
    "build": { "cache": true, "inputs": ["default"] },
    "test": { "cache": false }
  }
}
