# Copy to .env for local development. Every value here is the default,
# so the file is optional. Never commit a real .env.

LOBBYD_ENVIRONMENT=local
LOBBYD_DATABASE_URL=postgresql+asyncpg://lobbyd:lobbyd@localhost:5432/lobbyd
LOBBYD_REDIS_URL=redis://localhost:6379/0

# Required in production: a random value of at least 32 characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# LOBBYD_JWT_SECRET=

# Required in production: the private key that signs ticket QR codes.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# LOBBYD_TICKET_SIGNING_KEY=

# The payment simulator, and the secret it signs webhooks with (must match
# PAYSIM_WEBHOOK_SECRET on the simulator). Required in production.
LOBBYD_PAYSIM_URL=http://localhost:8001
# LOBBYD_PAYSIM_WEBHOOK_SECRET=
