        {
          "refId": "A",
          "expr": "sum(rate(lobbyd_outbox_published_total{topic=\"order.paid\"}[$__rate_interval])) * 60",
          "legendFormat": "orders/min",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
